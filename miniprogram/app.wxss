page {
  min-height: 100%;
  background: #e9f8ff;
  color: #222;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}
button {
  font: inherit;
  letter-spacing: 0;
}
button::after {
  border: 0;
}
.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
}
.mini-top {
  position: relative;
  height: 76rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.mini-top__title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  white-space: nowrap;
}
.empty {
  text-align: center;
  color: #8b9ba8;
  padding: 180rpx 30rpx;
}
.ux-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 7rpx 22rpx rgba(74, 130, 164, 0.1);
}
.primary {
  background: #1769e0;
  color: #fff;
  border-radius: 48rpx;
  font-weight: 600;
}
.muted {
  color: #8a9ba9;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
}
.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 7rpx 14rpx;
  border-radius: 7rpx;
  background: #7066b6;
  color: #fff;
  font-size: 20rpx;
}
.status-pill.pink {
  background: #e96ba4;
}
.status-pill.green {
  background: #46af82;
}
.status-pill.gray {
  background: #9ba8b2;
}
.icp-footer {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  color: #8194a1;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.5;
}
.icp-footer__link {
  color: #718697;
  text-decoration: underline;
}
