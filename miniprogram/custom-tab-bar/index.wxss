.tabbar {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 8rpx 28rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: #fff;
  border-top: 1rpx solid #e9eef2;
  box-shadow: 0 -5rpx 20rpx rgba(35, 78, 105, 0.06);
}
.tab {
  width: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  color: #8194a1;
  font-size: 20rpx;
  line-height: 28rpx;
}
.tab.active {
  color: #222;
  font-weight: 600;
}
.tab-icon {
  width: 46rpx;
  height: 46rpx;
  object-fit: contain;
}
.scan-tab {
  margin-top: -39rpx;
  color: #8194a1;
}
.scan-circle {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #ec659d;
  border: 10rpx solid #fff;
  box-shadow: 0 5rpx 15rpx rgba(236, 101, 157, 0.32);
}
.scan-glyph {
  position: relative;
  width: 43rpx;
  height: 43rpx;
}
.corner {
  position: absolute;
  width: 13rpx;
  height: 13rpx;
  border-color: #fff;
  border-style: solid;
}
.corner.tl {
  left: 0;
  top: 0;
  border-width: 4rpx 0 0 4rpx;
}
.corner.tr {
  right: 0;
  top: 0;
  border-width: 4rpx 4rpx 0 0;
}
.corner.bl {
  left: 0;
  bottom: 0;
  border-width: 0 0 4rpx 4rpx;
}
.corner.br {
  right: 0;
  bottom: 0;
  border-width: 0 4rpx 4rpx 0;
}
.scan-line {
  position: absolute;
  left: 7rpx;
  right: 7rpx;
  top: 20rpx;
  height: 4rpx;
  border-radius: 3rpx;
  background: #fff;
}
.scan-tab text {
  margin-top: 0;
}
