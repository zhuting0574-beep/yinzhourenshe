.detail-page{min-height:100vh;padding-bottom:155rpx;background:#e9f8ff}.content{padding:6rpx 28rpx 30rpx;display:grid;gap:22rpx}.product-card,.notice,.description,.address{background:#fff;border-radius:24rpx;box-shadow:0 7rpx 22rpx rgba(60,119,151,.08)}.product-card{padding:22rpx;display:flex;gap:25rpx}.product-card image{width:225rpx;height:196rpx;border-radius:19rpx;background:#eee}.product-card>view{flex:1;padding-top:12rpx}.name{font-size:32rpx;font-weight:700;line-height:1.35}.cost{margin-top:25rpx;padding:9rpx 12rpx;border-radius:30rpx;background:#eee;font-size:23rpx;text-align:center}.cost .strong{font-size:26rpx}.product-card text{display:block;margin-top:12rpx;color:#96a4ad;font-size:20rpx;text-align:right}.notice{padding:26rpx 28rpx}.notice-title{color:#e96ba4;font-size:29rpx;font-weight:700}.notice text{display:block;margin-top:13rpx;color:#718794;font-size:23rpx;line-height:1.75}.description{padding:28rpx;min-height:160rpx}.rich-content{display:block;margin-top:13rpx;color:#718794;font-size:23rpx;line-height:1.75;overflow:hidden}.address{padding:25rpx 28rpx;display:flex;align-items:center;justify-content:space-between}.address .strong,.address view text{display:block}.address view text{margin-top:10rpx;color:#8195a2;font-size:22rpx}.arrow{font-size:46rpx;color:#1769e0}.action{position:fixed;z-index:10;bottom:0;left:0;right:0;height:125rpx;padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;display:flex;justify-content:space-between;box-sizing:content-box}.action>view{display:flex;flex-direction:column}.action .strong{font-size:46rpx;color:#1769e0}.action .strong .small{font-size:23rpx;color:#222}.action>view>text{font-size:20rpx;color:#929292;margin-top:7rpx}.action button{width:280rpx;height:80rpx;margin:0;background:#1769e0;color:#fff;border-radius:44rpx;font-size:31rpx;font-weight:700}.action button[disabled]{background:#a5b6c4;color:#fff}
