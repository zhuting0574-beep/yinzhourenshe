.page{min-height:100vh;background:#eefaff;padding:24rpx 24rpx 150rpx}.product{width:100%;height:430rpx;background:#fff;border-radius:20rpx}.card,.notice{background:#fff;border-radius:18rpx;padding:30rpx;margin-top:22rpx}.title{font-size:36rpx;font-weight:700}.card text,.card small,.notice text{display:block;margin-top:18rpx;color:#73899a;line-height:1.8}.action{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:20rpx 30rpx;display:flex;justify-content:space-between;align-items:center}.action strong{font-size:42rpx;color:#1769e0}.action small{font-size:24rpx}.action button{margin:0;background:#1769e0;color:#fff;border-radius:50rpx;width:280rpx}
