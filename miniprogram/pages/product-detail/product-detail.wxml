<view wx:if="{{item}}" class="detail-page">
  <view class="safe-top"></view>
  <view class="mini-top">
    <view class="mini-nav">
      <button class="mini-nav__button" bindtap="back" aria-label="返回上一页">
        <view class="mini-nav__back"></view>
      </button>
      <view class="mini-nav__divider"></view>
      <button class="mini-nav__button" bindtap="home" aria-label="返回首页">
        <view class="mini-nav__home"></view>
      </button>
    </view>
    <view class="mini-top__title">积分兑换</view>
    <view class="capsule">•••　│　◎</view>
  </view>
  <view class="content">
    <view class="product-card">
      <image src="{{item.cover_url||'/assets/ux/detail-product.jpg'}}" mode="aspectFill"/>
      <view>
        <view class="name">{{item.name}}</view>
        <view class="cost">兑换积分：<text class="strong">{{item.points_cost}}积分</text></view>
        <text>可用库存 {{item.stock}}</text>
      </view>
    </view>
    <view class="notice">
      <view class="notice-title">温馨提示</view>
      <view class="notice-content">
        <text>点击兑换后请在周一至周五 9:00-17:00</text>
        <text>来“鄞领π”鄞州区大学生就业创业综合服务中心领取</text>
        <text>暂不支持快递运输，敬请谅解！</text>
      </view>
    </view>
    <view class="description">
      <view class="section-title">商品说明</view>
      <rich-text class="rich-content" nodes="{{item.description||'鄞领π定制好礼，数量有限，兑完即止。'}}">
      </rich-text>
    </view>
    <view class="address" bindtap="navigate">
      <view>
        <text class="strong">商品领取地址</text>
        <text>宁波市鄞州区学府路1号</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="action">
    <view>
      <text class="strong">-{{item.points_cost}} <text class="small">积分</text></text>
      <text>兑换后扣除</text>
    </view>
    <button bindtap="redeem" loading="{{submitting}}" disabled="{{item.stock<=0}}">{{item.stock>0?'我要兑换':'已兑完'}}</button>
  </view>
</view>
