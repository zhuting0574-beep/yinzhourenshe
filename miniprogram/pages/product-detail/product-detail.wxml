<view wx:if="{{item}}" class="page"><image class="product" src="{{item.cover_url}}" mode="aspectFit"/><view class="card"><view class="title">{{item.name}}</view><text>{{item.description}}</text><small>可用库存 {{item.stock}}</small></view><view class="notice">温馨提示<text>兑换成功后请于7个自然日内到鄞领π服务点领取，逾期订单自动取消并退回未过期积分。</text></view><view class="action"><strong>-{{item.points_cost}} <small>积分</small></strong><button bindtap="redeem" loading="{{submitting}}" disabled="{{item.stock<=0}}">{{item.stock>0?'我要兑换':'已兑完'}}</button></view></view>
