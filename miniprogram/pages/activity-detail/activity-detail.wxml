<view wx:if="{{item}}" class="page"><image class="cover" src="{{item.cover_url}}" mode="aspectFill"/><view class="card"><view class="title">{{item.title}}</view><text>报名：{{item.signup_start}} 至 {{item.signup_end}}</text><text>活动：{{item.start_time}} 至 {{item.end_time}}</text><view class="place" bindtap="navigate">{{item.place_name}} · {{item.address}} ›</view></view><view class="card"><strong>活动详情</strong><text>{{item.description}}</text></view><view class="action"><view><strong>+100</strong><small>现场扫码核销后</small></view><button bindtap="register" loading="{{submitting}}" disabled="{{item.participation_status}}">{{item.participation_status==='CHECKED_IN'?'已签到':item.participation_status==='REGISTERED'?'已报名':'我要报名'}}</button></view></view>
