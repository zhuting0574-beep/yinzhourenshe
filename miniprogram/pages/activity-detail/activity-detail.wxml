<view wx:if="{{item}}" class="detail-page">
  <view class="safe-top"></view>
  <view class="mini-top">
    <view class="mini-nav">
      <button class="mini-nav__button" bindtap="back" aria-label="返回上一页">
        <view class="mini-nav__back"></view>
      </button>
      <view class="mini-nav__divider"></view>
      <button class="mini-nav__button" bindtap="home" aria-label="返回首页">
        <view class="mini-nav__home"></view>
      </button>
    </view>
    <view class="mini-top__title">活动详情</view>
    <view class="capsule">•••　│　◎</view>
  </view>
  <image
    class="cover"
    src="{{item.cover_url||'/assets/ux/activity-orange.jpg'}}"
    mode="aspectFill"
  />
  <view class="detail-card first">
    <view class="title">{{item.title}}</view>
    <view class="info">报名时间：{{item.signup_start}} - {{item.signup_end}}</view>
    <view class="info">活动时间：{{item.start_time}} - {{item.end_time}}</view>
    <view class="place" bindtap="navigate">活动地点：{{item.place_name||item.address}} <text>›</text></view>
  </view>
  <view class="detail-card description">
    <view class="section-title">活动详情</view>
    <rich-text class="rich-content" nodes="{{item.description||'本次活动面向鄞州区青年人才，欢迎报名参加活动。'}}">
    </rich-text>
  </view>
  <view class="action">
    <view class="reward">
      <text class="strong">+100 <text class="small">积分</text></text>
      <text>{{item.checkin_mode==='LOCATION'?'定位签到后':item.checkin_mode==='BOTH'?'扫码或定位签到后':'扫码签到后'}}</text>
    </view>
    <button bindtap="primaryAction" loading="{{submitting}}" disabled="{{item.participation_status==='CHECKED_IN'}}">{{item.participation_status==='CHECKED_IN'?'已签到':item.participation_status==='REGISTERED'?(item.checkin_mode==='QR'?'扫码签到':'定位签到'):'我要报名'}}</button>
  </view>
</view>
