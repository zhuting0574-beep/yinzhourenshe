<view wx:if="{{item}}" class="detail-page">
  <safe-area-top />
  <view class="mini-top">
    <button class="mini-top__back" bindtap="back" aria-label="返回上一页"><view class="mini-top__back-icon"></view></button>
    <view class="mini-top__title">活动详情</view>
  </view>
  <image
    class="cover"
    src="{{item.cover_url||'/assets/ux/activity-orange.jpg'}}"
    mode="aspectFill"
  />
  <view class="detail-card first">
    <view class="title">{{item.title}}</view>
    <view class="info">报名时间：{{item.signup_start}} - {{item.signup_end}}</view>
    <view class="info">活动时间：{{item.start_time}} - {{item.end_time}}</view>
    <view class="place" bindtap="navigate">活动地点：{{item.place_name||item.address}} <text>›</text></view>
  </view>
  <view class="detail-card description">
    <view class="section-title">活动详情</view>
    <rich-text class="rich-content" nodes="{{item.description||'本次活动面向鄞州区青年人才，欢迎报名参加活动。'}}">
    </rich-text>
  </view>
  <view class="action">
    <view class="reward">
      <text class="strong">+{{item.points || 100}} <text class="small">积分</text></text>
      <text>{{rewardText}}</text>
    </view>
    <button bindtap="primaryAction" loading="{{submitting}}" disabled="{{actionDisabled}}">{{actionText}}</button>
  </view>
  <view wx:if="{{showRegistrationDialog}}" class="registration-mask" catchtap="closeRegistrationDialog">
    <view class="registration-dialog" catchtap="noop">
      <view class="registration-dialog__header">
        <text>{{registrationStep === 'confirm' ? '确认报名手机号' : '填写报名手机号'}}</text>
        <view class="registration-dialog__close" bindtap="closeRegistrationDialog">×</view>
      </view>
      <view wx:if="{{registrationStep === 'confirm'}}" class="registration-confirm">
        <view class="registration-dialog__hint">是否使用当前手机号报名？</view>
        <view class="registration-phone-current">{{currentPhone}}</view>
        <button class="registration-button registration-button--primary" bindtap="useCurrentPhone" loading="{{submitting}}">是，使用当前手机号</button>
        <button class="registration-button registration-button--secondary" bindtap="chooseOtherPhone">否，填写其他手机号</button>
      </view>
      <view wx:else class="registration-input-panel">
        <view class="registration-dialog__hint">请输入本次活动报名使用的手机号</view>
        <input class="registration-phone-input" type="number" maxlength="11" value="{{registrationPhone}}" bindinput="inputRegistrationPhone" placeholder="请输入11位手机号" />
        <view wx:if="{{phoneError}}" class="registration-phone-error">{{phoneError}}</view>
        <button class="registration-button registration-button--primary" bindtap="submitPhoneRegistration" loading="{{submitting}}">确认报名</button>
      </view>
    </view>
  </view>
  <navigator class="icp-footer icp-footer__link" url="/pages/icp/icp">浙ICP备2026084324号-1</navigator>
</view>
