<view wx:if="{{item}}" class="detail-page">
  <view class="safe-top"></view>
  <view class="mini-top">
    <view class="mini-nav">
      <button class="mini-nav__button" bindtap="back" aria-label="返回上一页">
        <view class="mini-nav__back"></view>
      </button>
      <view class="mini-nav__divider"></view>
      <button class="mini-nav__button" bindtap="home" aria-label="返回首页">
        <view class="mini-nav__home"></view>
      </button>
    </view>
    <view class="mini-top__title">活动详情</view>
    <view class="capsule">•••　│　◎</view>
  </view>
  <image
    class="cover"
    src="{{item.cover_url||'/assets/ux/activity-orange.jpg'}}"
    mode="aspectFill"
  />
  <view class="detail-card first">
    <view class="title">{{item.title}}</view>
    <view class="info">报名时间：{{item.signup_start}} - {{item.signup_end}}</view>
    <view class="info">活动时间：{{item.start_time}} - {{item.end_time}}</view>
    <view class="place" bindtap="navigate">活动地点：{{item.place_name||item.address}} <text>›</text></view>
  </view>
  <view class="detail-card description">
    <view class="section-title">活动详情</view>
    <rich-text class="rich-content" nodes="{{item.description||'本次活动面向鄞州区青年人才，欢迎报名参加活动。'}}">
    </rich-text>
  </view>
  <view class="action">
    <view class="reward">
      <text class="strong">+100 <text class="small">积分</text></text>
      <text>{{rewardText}}</text>
    </view>
    <button bindtap="primaryAction" loading="{{submitting}}" disabled="{{actionDisabled}}">{{actionText}}</button>
  </view>
  <view wx:if="{{showCheckinPicker}}" class="checkin-picker-mask" catchtap="closeCheckinPicker">
    <view class="checkin-picker" catchtap="noop">
      <view class="checkin-picker__title">选择签到方式</view>
      <view class="checkin-picker__hint">请选择本次活动的签到方式</view>
      <view class="checkin-picker__options">
        <button class="checkin-picker__option" data-mode="LOCATION" bindtap="chooseCheckin">定位签到</button>
        <button class="checkin-picker__option" data-mode="QR" bindtap="chooseCheckin">二维码签到</button>
      </view>
      <button class="checkin-picker__cancel" bindtap="closeCheckinPicker">取消</button>
    </view>
  </view>
</view>
