.detail-page {
  min-height: 100vh;
  background: #e9f8ff;
  padding-bottom: 150rpx;
}
.cover {
  display: block;
  width: calc(100% - 56rpx);
  height: 280rpx;
  margin: 0 28rpx;
  background: #f66b20;
  border-radius: 18rpx 18rpx 0 0;
}
.detail-card {
  background: #fff;
  margin: 24rpx 28rpx;
  border-radius: 18rpx;
  padding: 28rpx;
}
.detail-card.first {
  margin-top: 0;
  border-radius: 0 0 18rpx 18rpx;
}
.title {
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.info,
.place {
  font-size: 22rpx;
  color: #8495a1;
  line-height: 1.9;
}
.place text {
  float: right;
  color: #1769e0;
  font-size: 34rpx;
}
.description {
  min-height: 270rpx;
}
.rich-content {
  display: block;
  margin-top: 20rpx;
  font-size: 23rpx;
  line-height: 1.85;
  color: #8295a2;
  overflow: hidden;
}
.rich-content image,
.rich-content img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  vertical-align: top;
}
.rich-content p { margin: 0; padding: 0; }
.action {
  position: fixed;
  z-index: 10;
  bottom: 0;
  left: 0;
  right: 0;
  height: 126rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  box-sizing: content-box;
}
.reward {
  display: flex;
  flex-direction: column;
}
.reward .strong {
  font-size: 48rpx;
  color: #1769e0;
  line-height: 1.1;
}
.reward .strong .small {
  font-size: 23rpx;
  color: #222;
}
.reward > text {
  font-size: 20rpx;
  color: #929292;
  margin-top: 9rpx;
}
.action button {
  width: 280rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: 1;
  background: #1769e0;
  color: #fff;
  border-radius: 44rpx;
  font-size: 31rpx;
  font-weight: 700;
}
.action button[disabled] {
  background: #75a0d9;
  color: #fff;
}
.registration-mask {
  position: fixed;
  z-index: 30;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(18, 42, 58, 0.48);
}
.registration-dialog {
  position: relative;
  width: 100%;
  padding: 38rpx 30rpx 30rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 50rpx rgba(18, 42, 58, 0.2);
}
.registration-dialog__header {
  color: #222;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}
.registration-dialog__close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  color: #8a9aa6;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 46rpx;
  text-align: center;
}
.registration-dialog__hint {
  margin-top: 18rpx;
  color: #8a9aa6;
  font-size: 24rpx;
  text-align: center;
}
.registration-phone-current {
  margin: 18rpx 0 26rpx;
  color: #1769e0;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: center;
}
.registration-button {
  width: 100%;
  height: 78rpx;
  margin: 18rpx 0 0;
  padding: 0;
  border-radius: 40rpx;
  font-size: 27rpx;
  line-height: 78rpx;
}
.registration-button::after { border: 0; }
.registration-button--primary { background: #1769e0; color: #fff; }
.registration-button--secondary { background: #f2f6f8; color: #6d8290; }
.registration-phone-input {
  height: 82rpx;
  margin-top: 26rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #d8e3e9;
  border-radius: 12rpx;
  color: #253746;
  font-size: 30rpx;
}
.registration-phone-error {
  margin-top: 12rpx;
  color: #e24a4a;
  font-size: 23rpx;
}
