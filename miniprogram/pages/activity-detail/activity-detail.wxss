.detail-page {
  min-height: 100vh;
  background: #e9f8ff;
  padding-bottom: 150rpx;
}
.cover {
  display: block;
  width: calc(100% - 56rpx);
  height: 280rpx;
  margin: 0 28rpx;
  background: #f66b20;
  border-radius: 18rpx 18rpx 0 0;
}
.detail-card {
  background: #fff;
  margin: 24rpx 28rpx;
  border-radius: 18rpx;
  padding: 28rpx;
}
.detail-card.first {
  margin-top: 0;
  border-radius: 0 0 18rpx 18rpx;
}
.title {
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.info,
.place {
  font-size: 22rpx;
  color: #8495a1;
  line-height: 1.9;
}
.place text {
  float: right;
  color: #1769e0;
  font-size: 34rpx;
}
.description {
  min-height: 270rpx;
}
.rich-content {
  display: block;
  margin-top: 20rpx;
  font-size: 23rpx;
  line-height: 1.85;
  color: #8295a2;
  overflow: hidden;
}
.action {
  position: fixed;
  z-index: 10;
  bottom: 0;
  left: 0;
  right: 0;
  height: 126rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  box-sizing: content-box;
}
.reward {
  display: flex;
  flex-direction: column;
}
.reward .strong {
  font-size: 48rpx;
  color: #1769e0;
  line-height: 1.1;
}
.reward .strong .small {
  font-size: 23rpx;
  color: #222;
}
.reward > text {
  font-size: 20rpx;
  color: #929292;
  margin-top: 9rpx;
}
.action button {
  width: 280rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: 1;
  background: #1769e0;
  color: #fff;
  border-radius: 44rpx;
  font-size: 31rpx;
  font-weight: 700;
}
.action button[disabled] {
  background: #75a0d9;
  color: #fff;
}
.checkin-picker-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(18, 42, 58, 0.42);
}
.checkin-picker {
  width: 100%;
  padding: 30rpx 28rpx 24rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 -8rpx 36rpx rgba(18, 42, 58, 0.16);
}
.checkin-picker__title {
  color: #222;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}
.checkin-picker__hint {
  margin-top: 10rpx;
  color: #8a9aa6;
  font-size: 22rpx;
  text-align: center;
}
.checkin-picker__options {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}
.checkin-picker__option,
.checkin-picker__cancel {
  flex: 1;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 40rpx;
  font-size: 27rpx;
  line-height: 78rpx;
}
.checkin-picker__option::after,
.checkin-picker__cancel::after {
  border: 0;
}
.checkin-picker__option {
  background: #1769e0;
  color: #fff;
}
.checkin-picker__cancel {
  width: 100%;
  margin-top: 18rpx;
  background: #f2f6f8;
  color: #6d8290;
}
