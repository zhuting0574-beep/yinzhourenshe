.page{min-height:100vh;background:#eefaff;padding-bottom:140rpx}.cover{width:100%;height:340rpx;background:#f26d32}.card{background:#fff;margin:24rpx;border-radius:18rpx;padding:30rpx}.card text,.card strong{display:block;line-height:2;color:#60798d}.title{font-size:36rpx;font-weight:700;margin-bottom:18rpx}.place{margin-top:18rpx;color:#1769e0}.action{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:20rpx 30rpx;display:flex;justify-content:space-between;align-items:center}.action strong,.action small{display:block}.action strong{font-size:46rpx;color:#1769e0}.action button{margin:0;background:#1769e0;color:#fff;border-radius:50rpx;width:280rpx}
