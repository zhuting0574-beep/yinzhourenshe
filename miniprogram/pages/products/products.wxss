.page{padding:32rpx;background:#eefaff;min-height:100vh}.title{font-size:40rpx;font-weight:600;margin-bottom:24rpx}.tip{background:#1769e0;color:#fff;border-radius:18rpx;padding:28rpx;margin-bottom:28rpx}.product{display:flex;background:#fff;border-radius:18rpx;padding:20rpx;margin-bottom:20rpx}.product image{width:190rpx;height:180rpx;border-radius:12rpx;background:#edf4f8}.info{padding:12rpx 0 0 24rpx;flex:1}.info text,.info small{display:block}.info text{color:#ef649e;margin:20rpx 0}.info small{color:#91a4b3}.empty{color:#9aaabd;text-align:center;padding:120rpx 0}.scan{position:fixed;left:50%;bottom:18rpx;transform:translateX(-50%);width:92rpx;height:92rpx;border-radius:50%;background:#ef649e;color:#fff;font-size:44rpx;border:8rpx solid #fff;line-height:76rpx}
