.page{padding:32rpx;background:#f6fbff;min-height:100vh}.title{font-size:40rpx;font-weight:600;margin-bottom:24rpx}.product{display:flex;background:#fff;border-radius:16rpx;padding:20rpx;margin-bottom:20rpx}.product image{width:180rpx;height:180rpx;border-radius:12rpx}.info{padding:12rpx 0 0 24rpx;flex:1}.info text{display:block;color:#ef649e;margin:20rpx 0}.empty{color:#9aaabd;text-align:center;padding:120rpx 0}
