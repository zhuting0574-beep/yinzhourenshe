<view class="page"><view class="title">积分兑换</view><view wx:if="{{!loading && !items.length}}" class="empty">暂无商品</view><view wx:for="{{items}}" wx:key="id" class="product"><image src="{{item.imageUrl}}" mode="aspectFill"/><view class="info"><view>{{item.name}}</view><text>{{item.points}} 积分</text><button size="mini">兑换</button></view></view></view>
