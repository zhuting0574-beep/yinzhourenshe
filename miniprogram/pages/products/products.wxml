<view class="page"><view class="title">积分兑换</view><navigator class="tip" url="/pages/activities/activities">参与线下活动获取更多积分 ›</navigator><view wx:if="{{!loading && !items.length}}" class="empty">暂无商品</view><view wx:for="{{items}}" wx:key="id" class="product" data-id="{{item.id}}" bindtap="open"><image src="{{item.cover_url}}" mode="aspectFill"/><view class="info"><view>{{item.name}}</view><text>{{item.points_cost}} 积分</text><small>{{item.stock>0?'剩余 '+item.stock:'已兑完'}}</small></view></view><button class="scan" bindtap="scan">⌗</button></view>
