<view class="page"><view class="title">个人中心</view><view class="user" bindtap="login"><image src="{{user.avatar_url||'/assets/profile-avatar.png'}}"/><view><strong>{{loggedIn?(user.nickname||'微信用户'):'未登录'}}</strong><small>{{loggedIn?(user.phone||'授权手机号后可参与积分活动'):'登录后，兑换领取更多好礼~'}}</small></view></view><button wx:if="{{loggedIn&&!user.phone}}" open-type="getPhoneNumber" bindgetphonenumber="phone">授权手机号并完成注册</button><view class="points"><view>可用积分 <text>{{user.points||0}}</text></view><view class="links"><navigator url="/pages/points/points">积分明细</navigator><navigator url="/pages/orders/orders">兑换记录</navigator><navigator url="/pages/rules/rules">积分规则</navigator></view></view><navigator class="service" url="/pages/rules/rules">点击导航至“鄞领π”<small>宁波市鄞州区学府路1号</small></navigator><button class="scan" bindtap="scan">⌗</button></view>
