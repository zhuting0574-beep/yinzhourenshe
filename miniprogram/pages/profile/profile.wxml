<view class="page-shell profile-page">
  <view class="profile-bg">
    <image class="profile-silhouette" src="/assets/ux/profile-silhouette.png" mode="widthFix"/>
    <safe-area-top />
    <view class="mini-top">
      <view class="mini-top__title">个人中心</view>
    </view>
    <view class="account" bindtap="openLogin">
      <image src="{{user.avatar_url||user.avatarUrl||'/assets/profile-avatar.png'}}"/>
      <view>
        <text class="strong">{{loggedIn?(user.real_name||user.realName||user.nickname||'微信用户'):'未登录'}}</text>
        <text class="small">{{loggedIn?(user.phone||'授权手机号后可参与积分活动'):'登录后，兑换领取更多好礼~'}}</text>
      </view>
    </view>
    <view wx:if="{{!loggedIn}}" class="account-actions">
      <button class="account-action-btn account-action-btn--primary" open-type="getPhoneNumber" bindgetphonenumber="phone">授权手机号并完成注册</button>
    </view>
    <view wx:if="{{loggedIn}}" class="account-actions">
      <button class="account-action-btn account-action-btn--primary" bindtap="editProfile">
        完善信息<text wx:if="{{!profileComplete}}" class="profile-reward">+100积分</text>
      </button>
      <button class="account-action-btn account-action-btn--outline" bindtap="logout">退出登录</button>
    </view>
    <view class="points-card">
      <view class="balance">
        <text>◉　可用积分</text>
        <text class="strong">{{user.points||0}}</text>
      </view>
      <view class="links">
        <navigator url="/pages/points/points">
          <image src="/assets/profile-points.png" mode="aspectFit"/>
          <text>积分明细</text>
        </navigator>
        <navigator url="/pages/orders/orders">
          <image src="/assets/profile-orders.png" mode="aspectFit"/>
          <text>兑换记录</text>
        </navigator>
        <view class="profile-link" bindtap="showRules">
          <image src="/assets/profile-rules.png" mode="aspectFit"/>
          <text>积分规则</text>
        </view>
      </view>
    </view>
    <view class="service" bindtap="navigate">
      <image src="/assets/ux/profile-navigation.jpg" mode="widthFix"/>
    </view>
  </view>
  <view wx:if="{{rulesVisible}}" class="rules-mask" catchtap="closeRules">
    <view class="rules-modal" catchtap="noop">
      <view class="rules-modal__head"><text>积分使用规则</text><button class="rules-modal__close" bindtap="closeRules">×</button></view>
      <scroll-view scroll-y class="rules-modal__body"><rich-text nodes="{{rulesContent}}" /></scroll-view>
    </view>
  </view>
  <navigator class="icp-footer icp-footer__link" url="/pages/icp/icp">浙ICP备2026084324号-1</navigator>
</view>
