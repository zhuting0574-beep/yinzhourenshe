.page{padding:32rpx;background:#dff4ff;min-height:100vh}.title{text-align:center;font-size:40rpx;font-weight:600}.user{display:flex;align-items:center;gap:28rpx;margin:50rpx 0}.user image{width:150rpx;height:150rpx;border-radius:50%;background:#ddd;border:8rpx solid #fff}.user strong,.user small{display:block}.user strong{font-size:44rpx}.user small{margin-top:14rpx}.points{background:#0750bd;color:#fff;border-radius:28rpx;overflow:hidden}.points>view:first-child{padding:30rpx;font-size:30rpx}.points text{float:right;font-size:60rpx}.links{display:flex;background:#fff;color:#222;padding:30rpx 0}.links navigator{flex:1;text-align:center;border-right:1rpx solid #ddd}.links navigator:last-child{border:0}.service{margin-top:46rpx;background:#0750bd;color:#fff;border-radius:28rpx;padding:34rpx}.service small{display:block;margin-top:22rpx}.scan{position:fixed;left:50%;bottom:18rpx;transform:translateX(-50%);width:92rpx;height:92rpx;border-radius:50%;background:#ef649e;color:#fff;font-size:44rpx;border:8rpx solid #fff;line-height:76rpx}
