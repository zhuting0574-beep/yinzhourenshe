.login-page {
  min-height: 100vh;
  background: #e9f8ff;
}
.login-page .mini-top {
  padding: 0 28rpx;
}
.login-back {
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}
.login-back::after {
  border: 0;
}
.login-back__icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #222;
  border-bottom: 4rpx solid #222;
  transform: rotate(45deg);
}
.login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 156rpx 54rpx 80rpx;
}
.login-avatar {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 30rpx rgba(23, 105, 224, 0.16);
}
.login-title {
  margin-top: 38rpx;
  color: #1c3f60;
  font-size: 40rpx;
  font-weight: 700;
}
.login-subtitle {
  margin-top: 18rpx;
  color: #8495a1;
  font-size: 24rpx;
  text-align: center;
}
.login-button {
  width: 100%;
  height: 88rpx;
  margin: 72rpx 0 0;
  padding: 0;
  border-radius: 46rpx;
  background: #1769e0;
  color: #fff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 88rpx;
}
.agreement-row {
  width: 100%;
  margin-top: 42rpx;
  color: #8294a0;
  font-size: 21rpx;
  line-height: 1.8;
}
.agreement-item {
  display: flex;
  align-items: center;
  margin: 10rpx 0;
}
.agreement-item checkbox { transform: scale(.72); margin-right: 2rpx; }
.agreement-link { color: #1769e0; text-decoration: underline; margin-left: 8rpx; }
.login-button::after {
  border: 0;
}
.login-note {
  margin-top: 24rpx;
  color: #9aabb7;
  font-size: 20rpx;
}
.agreement-mask { position: fixed; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(0,0,0,.45); box-sizing: border-box; }
.agreement-dialog { width: 100%; max-height: 82vh; overflow: hidden; border-radius: 20rpx; background: #fff; }
.agreement-dialog__header { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 32rpx; font-size: 32rpx; font-weight: 700; color: #1c3f60; border-bottom: 1rpx solid #edf1f4; }
.agreement-dialog__close { font-size: 48rpx; line-height: 36rpx; font-weight: 300; color: #8495a1; }
.agreement-dialog__body { height: 58vh; padding: 28rpx 32rpx; box-sizing: border-box; color: #384b59; font-size: 25rpx; line-height: 1.75; }
.agreement-dialog__button { margin: 18rpx 28rpx 28rpx; height: 78rpx; line-height: 78rpx; border-radius: 40rpx; background: #1769e0; color: #fff; font-size: 28rpx; }
