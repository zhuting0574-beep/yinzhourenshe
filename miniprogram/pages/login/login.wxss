.login-page {
  min-height: 100vh;
  background: #e9f8ff;
}
.login-page .mini-top {
  padding: 0 28rpx;
}
.login-page .mini-nav__button {
  margin: 0;
}
.login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 156rpx 54rpx 80rpx;
}
.login-avatar {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 30rpx rgba(23, 105, 224, 0.16);
}
.login-title {
  margin-top: 38rpx;
  color: #1c3f60;
  font-size: 40rpx;
  font-weight: 700;
}
.login-subtitle {
  margin-top: 18rpx;
  color: #8495a1;
  font-size: 24rpx;
  text-align: center;
}
.login-button {
  width: 100%;
  height: 88rpx;
  margin: 72rpx 0 0;
  padding: 0;
  border-radius: 46rpx;
  background: #1769e0;
  color: #fff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 88rpx;
}
.login-button::after {
  border: 0;
}
.login-note {
  margin-top: 24rpx;
  color: #9aabb7;
  font-size: 20rpx;
}
