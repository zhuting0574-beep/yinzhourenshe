<view class="page"><view class="title">每日签到</view><view class="days"><view wx:for="{{days}}" wx:key="date" data-date="{{item.date}}" bindtap="choose" class="day {{selected==item.date?'active':''}}"><text>周{{item.label}}</text><text>{{item.date}}</text></view></view><button class="primary" bindtap="submit" disabled="{{checked || !selected}}">{{checked?'已签到':'立即签到'}}</button><view class="reward">每日签到奖励1积分</view><view class="join">参加活动赚积分</view></view>
