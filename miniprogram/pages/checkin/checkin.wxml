<view class="checkin-page">
  <safe-area-top />
  <view class="mini-top">
    <view class="mini-top__title">每日签到</view>
  </view>
  <view class="score">
    <text>我的积分</text>
    <text class="strong">{{points}}</text>
  </view>
  <view class="calendar">
    <view class="month">{{year}}年{{month}}月</view>
    <view class="count">本月已签到{{count}}天</view>
    <view class="week">
      <text>一</text>
      <text>二</text>
      <text>三</text>
      <text>四</text>
      <text>五</text>
      <text>六</text>
      <text>日</text>
    </view>
    <scroll-view
      class="calendar-scroll"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{calendarDays.length?'calendar-focus':''}}"
      bindscroll="scrollCalendar"
    >
      <view class="calendar-grid" style="width:{{calendarDays.length*86-8}}rpx">
        <view wx:for="{{calendarDays}}" wx:key="day" id="{{item.focus?'calendar-focus':''}}" class="{{item.today?'today':''}} {{item.checked?'checked':''}}">{{item.label}}</view>
      </view>
    </scroll-view>
    <view class="progress">
      <view class="i" style="transform:translateX({{scrollProgress*50}}rpx)"></view>
    </view>
    <button class="check-btn" bindtap="submit" disabled="{{todayChecked||submitting}}">
      <text>{{todayChecked?'今日已签到':'立即签到'}}</text>
      <text class="small">每日签到奖励10积分</text>
    </button>
  </view>
  <view class="tasks">
    <view class="tasks-title">参加活动赚积分</view>
    <view class="task-body">
      <navigator url="/pages/questionnaire/questionnaire" class="task">
        <image src="/assets/ux/checkin-survey.jpg"/>
        <view>
          <text class="strong">填写调查问卷</text>
          <text>去填写</text>
        </view>
      </navigator>
      <navigator url="/pages/activities/activities" open-type="switchTab" class="task">
        <image src="/assets/ux/checkin-activity.jpg"/>
        <view>
          <text class="strong">参加线下活动</text>
          <text class="purple">去报名</text>
        </view>
      </navigator>
    </view>
  </view>
  <navigator class="icp-footer icp-footer__link" url="/pages/icp/icp">浙ICP备2026084324号-1</navigator>
</view>
