.page{padding:32rpx;background:#eefaff;min-height:100vh}.title{font-size:40rpx;font-weight:600;text-align:center}.score{text-align:right;padding:30rpx}.score text,.score strong{display:block}.score strong{font-size:70rpx}.calendar{background:#fff;border-radius:24rpx;padding:32rpx}.days{display:flex;flex-wrap:wrap;gap:12rpx;margin:35rpx 0}.days text{background:#f7f9fa;border-radius:10rpx;padding:14rpx}.primary{background:#ef7138;color:#fff;border-radius:48rpx}.reward{text-align:center;color:#7c8b99;font-size:24rpx;margin:18rpx}.join{margin-top:28rpx;background:#e879af;padding:34rpx;border-radius:20rpx;color:#fff}.join text{float:right}.join.activity{background:#8574e7}
