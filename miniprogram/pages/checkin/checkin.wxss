.page{padding:32rpx;background:#f6fbff;min-height:100vh}.title{font-size:40rpx;font-weight:600}.days{display:flex;gap:12rpx;margin:40rpx 0}.day{width:78rpx;height:100rpx;background:#fff;border:2rpx solid #e6edf2;border-radius:8rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx}.day.active{border-color:#ef649e;color:#ef649e}.primary{background:#ef649e;color:#fff;border-radius:48rpx}.reward{text-align:center;color:#7c8b99;font-size:24rpx;margin:18rpx}.join{margin-top:80rpx;background:#c9edff;padding:30rpx;border-radius:16rpx;color:#23516b}
