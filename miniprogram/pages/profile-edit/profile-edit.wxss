.profile-edit-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #f5fbff;
}
.mini-top {
  position: relative;
  z-index: 20;
  height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mini-top__title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #173d61;
  font-size: 34rpx;
  font-weight: 600;
  white-space: nowrap;
}
.profile-edit-head {
  margin: 16rpx 28rpx 22rpx;
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #c8efff, #fff0f7);
  box-shadow: 0 8rpx 24rpx rgba(70, 135, 170, 0.09);
}
.profile-edit-title {
  color: #173d61;
  font-size: 38rpx;
  font-weight: 700;
}
.profile-edit-subtitle {
  margin-top: 12rpx;
  color: #6f8797;
  font-size: 25rpx;
}
.avatar-editor {
  display: flex;
  justify-content: center;
  margin: 0 28rpx 22rpx;
}
.avatar-picker {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0;
  padding: 12rpx 26rpx 12rpx 12rpx;
  border: 0;
  border-radius: 56rpx;
  background: #fff;
  color: #31536d;
  font-size: 26rpx;
  box-shadow: 0 7rpx 22rpx rgba(65, 120, 150, 0.07);
}
.avatar-picker::after { border: 0; }
.avatar-picker__image { width: 88rpx; height: 88rpx; border-radius: 50%; }
.profile-form {
  margin: 0 28rpx;
  padding: 4rpx 28rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 7rpx 22rpx rgba(65, 120, 150, 0.07);
}
.form-row {
  min-height: 106rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #edf2f5;
}
.form-row:last-child {
  border-bottom: 0;
}
.form-label {
  width: 170rpx;
  color: #173d61;
  font-size: 27rpx;
  flex-shrink: 0;
}
.form-input {
  min-width: 0;
  flex: 1;
  color: #314e63;
  font-size: 27rpx;
  text-align: right;
}
.form-input::placeholder {
  color: #abbac4;
  font-size: 25rpx;
}
.form-picker {
  min-width: 0;
  flex: 1;
  text-align: right;
}
.picker-value {
  color: #abbac4;
  font-size: 25rpx;
}
.picker-value--selected {
  color: #314e63;
  font-size: 27rpx;
}
.submit-bar {
  position: fixed;
  z-index: 10;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.submit-bar button {
  width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0;
  background: #1769e0;
  color: #fff;
  border-radius: 45rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}
.submit-bar button::after {
  border: 0;
}
.custom-picker {
  position: fixed;
  z-index: 100;
  inset: 0;
}
.custom-picker__mask {
  position: absolute;
  inset: 0;
  background: rgba(16, 34, 48, 0.42);
}
.custom-picker__sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-shadow: 0 -8rpx 32rpx rgba(32, 76, 104, 0.16);
}
.custom-picker__header {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 34rpx;
  border-bottom: 1rpx solid #edf2f5;
}
.custom-picker__title {
  color: #173d61;
  font-size: 30rpx;
  font-weight: 600;
}
.custom-picker__cancel,
.custom-picker__confirm {
  min-width: 80rpx;
  font-size: 27rpx;
}
.custom-picker__cancel { color: #8b9aa5; }
.custom-picker__confirm { color: #1769e0; text-align: right; }
.custom-picker__list {
  height: 520rpx;
  box-sizing: border-box;
  padding: 12rpx 30rpx 20rpx;
}
.custom-picker__option {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #526b7a;
  font-size: 29rpx;
  border-radius: 14rpx;
}
.custom-picker__option--selected {
  color: #1769e0;
  background: #edf5ff;
  font-weight: 600;
}
