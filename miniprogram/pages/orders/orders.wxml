<view class="records-page">
  <safe-area-top />
  <view class="mini-top">
    <view class="mini-top__title">兑换记录</view>
  </view>
  <view wx:if="{{!items.length}}" class="empty">暂无兑换记录</view>
  <view class="record-list">
    <view wx:for="{{items}}" wx:key="id" class="record-card">
      <view class="record-head">
        <text class="strong">{{item.product_name}}</text>
        <text class="status-pill {{item.status==='PICKED_UP'?'green':item.status==='CANCELED'?'gray':'pink'}}">{{item.status==='PENDING'?'待核销':item.status==='PICKED_UP'?'已核销':item.status==='CANCELED'?'已取消':item.status}}</text>
      </view>
      <view class="line">订单编号：{{item.order_no}}</view>
      <view class="line">消耗积分：{{item.points}}</view>
      <view class="line">领取截止：{{item.expire_at}}</view>
      <view wx:if="{{item.cancel_reason}}" class="reason">取消原因：{{item.cancel_reason}}</view>
      <view wx:if="{{item.status==='PENDING'}}" class="tip">{{recordNotice}}</view>
    </view>
  </view>
  <navigator class="icp-footer icp-footer__link" url="/pages/icp/icp">浙ICP备2026084324号-1</navigator>
</view>
