<view class="page"><view class="title">兑换记录</view><view wx:if="{{!items.length}}" class="empty">暂无兑换记录</view><view wx:for="{{items}}" wx:key="id" class="card"><view><strong>{{item.product_name}}</strong><small>订单号 {{item.order_no}}</small><small>消耗 {{item.points}} 积分</small><small>领取截止 {{item.expire_at}}</small><small wx:if="{{item.cancel_reason}}">{{item.cancel_reason}}</small></view><text>{{item.status}}</text></view></view>
