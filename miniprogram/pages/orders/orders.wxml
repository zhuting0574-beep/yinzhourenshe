<view class="records-page">
  <safe-area-top />
  <view class="mini-top">
    <button class="mini-top__back" bindtap="back" aria-label="返回上一页"><view class="mini-top__back-icon"></view></button>
    <view class="mini-top__title">兑换记录</view>
  </view>
  <view wx:if="{{!items.length}}" class="empty">暂无兑换记录</view>
  <view class="record-list">
    <view wx:for="{{items}}" wx:key="id" class="record-card">
      <view class="record-head">
        <text class="strong">{{item.product_name}}</text>
        <text class="status-pill {{item.status==='PICKED_UP'?'green':item.status==='CANCELED'?'gray':'pink'}}">{{item.status==='PENDING'?'待核销':item.status==='PICKED_UP'?'已核销':item.status==='CANCELED'?'已取消':item.status}}</text>
      </view>
      <view class="line">订单编号：{{item.order_no}}</view>
      <view class="line">消耗积分：{{item.points}}</view>
      <view class="line">领取截止：{{item.expire_at}}</view>
      <view wx:if="{{item.cancel_reason}}" class="reason">取消原因：{{item.cancel_reason}}</view>
      <view wx:if="{{item.status==='PENDING'}}" class="tip">{{recordNotice}}</view>
      <button wx:if="{{item.status==='PICKED_UP' && item.product_type !== 'PHYSICAL'}}" class="coupon-show-button" data-order="{{item}}" bindtap="showCoupon" loading="{{couponLoading}}">展示券</button>
    </view>
  </view>
  <navigator class="icp-footer icp-footer__link" url="/pages/icp/icp">浙ICP备2026084324号-1</navigator>
  <view wx:if="{{couponVisible}}" class="coupon-mask" catchtap="closeCoupon"><view class="coupon-sheet" catchtap="noop"><view class="coupon-sheet__head"><text>{{couponType === 'METRO_COUPON' ? '地铁乘车券' : '咖啡兑换券'}}</text><text class="coupon-close" bindtap="closeCoupon">×</text></view><block wx:if="{{couponType === 'METRO_COUPON'}}"><image wx:if="{{couponQrPath}}" class="coupon-qr" src="{{couponQrPath}}" mode="aspectFit" show-menu-by-longpress="true" /><view wx:else class="coupon-loading">二维码加载中...</view><view class="coupon-hint">长按二维码可保存到相册</view></block><block wx:else><view class="coffee-code">{{couponCode}}</view><button class="copy-button" bindtap="copyCoupon">复制兑换码</button></block></view></view>
</view>
