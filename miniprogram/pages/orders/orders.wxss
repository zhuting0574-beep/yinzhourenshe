.page{padding:32rpx;background:#eefaff;min-height:100vh}.title{font-size:40rpx;font-weight:600}.card{background:#fff;padding:26rpx;margin-top:20rpx;border-radius:16rpx;display:flex;justify-content:space-between}.card strong,.card small{display:block}.card small{color:#91a4b3;font-size:22rpx;margin-top:10rpx}.card>text{color:#ef649e}.empty{text-align:center;color:#9aaabd;padding:120rpx 0}
