.activities-page {
  background: #e9f8ff;
}
.search {
  height: 88rpx;
  margin: 12rpx 30rpx 28rpx;
  padding: 0 30rpx;
  border-radius: 44rpx;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 15rpx;
  box-shadow: 0 8rpx 25rpx rgba(67, 141, 180, 0.1);
  color: #aab5bc;
}
.search text {
  font-size: 34rpx;
}
.search input {
  flex: 1;
  font-size: 25rpx;
}
.activity-list {
  padding: 0 30rpx 24rpx;
}
.activity-card {
  margin-bottom: 28rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(58, 116, 148, 0.1);
}
.cover-wrap {
  position: relative;
  height: 274rpx;
  background: #f66b20;
}
.cover-wrap image {
  width: 100%;
  height: 100%;
}
.cover-wrap .status-pill {
  position: absolute;
  left: 15rpx;
  top: 14rpx;
}
.activity-info {
  padding: 20rpx 25rpx 24rpx;
}
.name {
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
}
.meta {
  margin-top: 12rpx;
  color: #a1a9ad;
  font-size: 21rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
