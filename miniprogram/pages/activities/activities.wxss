.page{padding:32rpx;background:#eefaff;min-height:100vh}.title{font-size:40rpx;font-weight:600;margin-bottom:24rpx}.card{position:relative;background:#fff;padding:0 0 24rpx;border-radius:16rpx;margin-bottom:24rpx;overflow:hidden;box-shadow:0 8rpx 24rpx #dcebf255}.card image{width:100%;height:230rpx;background:#dceef6}.name,.meta{padding:0 24rpx}.name{font-size:32rpx;margin-top:18rpx}.meta{color:#7c8b99;font-size:22rpx;margin-top:12rpx}.tag{position:absolute;right:20rpx;bottom:20rpx;color:#1769e0;font-size:22rpx}.scan{position:fixed;left:50%;bottom:18rpx;transform:translateX(-50%);width:92rpx;height:92rpx;border-radius:50%;background:#ef649e;color:#fff;font-size:44rpx;border:8rpx solid #fff;line-height:76rpx}.empty{text-align:center;color:#91a5b4;padding:180rpx 0}
