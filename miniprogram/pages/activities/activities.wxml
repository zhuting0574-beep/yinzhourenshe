<view class="page"><view class="title">活动报名</view><view wx:if="{{!loading && !items.length}}" class="empty">暂无活动</view><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><image src="{{item.cover_url}}" mode="aspectFill"/><view class="name">{{item.title}}</view><view class="meta">{{item.start_time}} - {{item.end_time}}</view><text class="tag">{{item.participation_status||'查看详情'}}</text></view><button class="scan" bindtap="scan">⌗</button></view>
