<view class="page-shell activities-page">
  <safe-area-top />
  <view class="mini-top">
    <view class="mini-top__title">活动报名</view>
  </view>
  <view class="search">
    <text>⌕</text>
    <input placeholder="输入活动标题" bindinput="search"/>
  </view>
  <view wx:if="{{!loading && !displayItems.length}}" class="empty">暂无活动</view>
  <view class="activity-list">
    <view
      wx:for="{{displayItems}}"
      wx:key="id"
      class="activity-card"
      data-id="{{item.id}}"
      bindtap="open"
    >
      <view class="cover-wrap">
        <image src="{{item.cover_url||'/assets/ux/activity-orange.jpg'}}" mode="aspectFill"/>
        <text class="status-pill">{{item.participation_status==='REGISTERED'?'已报名':'活动报名中'}}</text>
      </view>
      <view class="activity-info">
        <view class="name">{{item.title}}</view>
        <view class="meta">活动时间：{{item.start_time}} - {{item.end_time}}</view>
      </view>
    </view>
  </view>
  <navigator class="icp-footer icp-footer__link" url="/pages/icp/icp">浙ICP备2026084324号-1</navigator>
</view>
