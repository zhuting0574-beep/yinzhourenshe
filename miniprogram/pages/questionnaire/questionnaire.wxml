<view class="page"><view wx:if="{{!questionnaire}}" class="empty">本月暂无可填写问卷</view><block wx:else><view class="title">{{questionnaire.name}}</view><view class="intro">{{questionnaire.description}}<text>完成奖励 100 积分</text></view><view wx:if="{{questionnaire.completedThisMonth}}" class="done">本月已完成问卷</view><view wx:for="{{questions}}" wx:key="id" class="question"><view>{{index+1}}. {{item.title}} <text wx:if="{{item.required}}">*</text></view><radio-group wx:if="{{item.question_type==='SINGLE'}}" data-id="{{item.id}}" bindchange="change"><label wx:for="{{item.options}}" wx:key="*this"><radio value="{{item}}"/>{{item}}</label></radio-group><checkbox-group wx:elif="{{item.question_type==='MULTIPLE'}}" data-id="{{item.id}}" bindchange="change"><label wx:for="{{item.options}}" wx:key="*this"><checkbox value="{{item}}"/>{{item}}</label></checkbox-group><textarea wx:else data-id="{{item.id}}" bindinput="change" placeholder="请输入回答"/></view><button wx:if="{{!questionnaire.completedThisMonth}}" bindtap="submit" loading="{{submitting}}">提交问卷</button></block></view>
