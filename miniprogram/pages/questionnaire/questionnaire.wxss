.survey-page{min-height:100vh;padding-bottom:150rpx;background:#f5fbff}.survey-head{margin:8rpx 28rpx 26rpx;padding:32rpx;border-radius:24rpx;background:linear-gradient(145deg,#c8efff,#fff0f7);box-shadow:0 8rpx 24rpx rgba(70,135,170,.09)}.title{margin-top:20rpx;font-size:38rpx;font-weight:700}.intro{margin-top:14rpx;color:#6f8797;font-size:24rpx;line-height:1.6}.reward{margin-top:23rpx;color:#e05b97}.reward .strong{font-size:38rpx}.done{margin:0 28rpx 22rpx;padding:22rpx;text-align:center;border-radius:18rpx;background:#e8f7f1;color:#2f9b72}.questions{padding:0 28rpx}.question{padding:28rpx;margin-bottom:22rpx;border-radius:22rpx;background:#fff;box-shadow:0 7rpx 22rpx rgba(65,120,150,.07)}.question-title{font-size:28rpx;font-weight:600}.question-title text{color:#e65c98}.question label{display:block;margin-top:17rpx;padding:20rpx;border:1rpx solid #e1eaf0;border-radius:14rpx;color:#536f82;font-size:24rpx}.question radio,.question checkbox{transform:scale(.82)}textarea{width:100%;height:150rpx;margin-top:20rpx;padding:20rpx;border:1rpx solid #e1eaf0;border-radius:14rpx;box-sizing:border-box;font-size:24rpx}.submit-bar{position:fixed;z-index:10;left:0;right:0;bottom:0;padding:18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff}.submit-bar button{background:#1769e0;color:#fff;border-radius:45rpx;font-size:28rpx;font-weight:600}
