<view class="ledger-page">
  <safe-area-top />
  <view class="mini-top">
    <view class="mini-top__title">积分明细</view>
  </view>
  <view class="balance">
    <text class="small">当前积分</text>
    <text class="strong">{{points}}</text>
    <text>积分</text>
  </view>
  <view class="list">
    <view wx:for="{{items}}" wx:key="id" class="row">
      <text class="amount {{item.amount<0?'minus':''}}">{{item.amount>0?'+':''}}{{item.amount}}</text>
      <view>
        <text class="strong">{{item.remark}}</text>
        <text class="small">{{item.created_at}}</text>
      </view>
      <text class="after">余额 {{item.balance}}</text>
    </view>
  </view>
  <navigator class="icp-footer icp-footer__link" url="/pages/icp/icp">浙ICP备2026084324号-1</navigator>
</view>
