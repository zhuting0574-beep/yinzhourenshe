.page{min-height:100vh;background:#eefaff;padding:24rpx}.banner{height:320rpx;border-radius:18rpx;overflow:hidden;background:#c9edff}.banner image{width:100%;height:100%}.banner swiper-item{position:relative}.banner swiper-item>text{position:absolute;left:28rpx;bottom:24rpx;color:#fff;font-size:32rpx}.banner-fallback{height:100%;display:flex;flex-direction:column;justify-content:center;padding-left:40rpx;font-size:54rpx;font-weight:800;color:#1769e0}.banner-fallback small{font-size:24rpx;margin-top:18rpx;color:#55748c}.hello{padding:20rpx 8rpx 8rpx;color:#547086}.quick{display:flex;gap:18rpx;margin:18rpx 0}.quick navigator{background:#fff;border-radius:18rpx;padding:38rpx 12rpx;flex:1;text-align:center;color:#294a64;box-shadow:0 8rpx 28rpx #a9d9eb55}.section{font-size:32rpx;font-weight:700;margin:30rpx 0 12rpx}.card{display:flex;gap:20rpx;background:#fff;border-radius:16rpx;padding:18rpx;margin:16rpx 0}.card image{width:180rpx;height:130rpx;border-radius:12rpx;background:#dceef6}.card text,.card small{display:block}.card small{font-size:22rpx;color:#879bab;margin-top:16rpx}.scan{position:fixed;left:50%;bottom:18rpx;transform:translateX(-50%);width:92rpx;height:92rpx;border-radius:50%;background:#ef649e;color:#fff;font-size:44rpx;border:8rpx solid #fff;line-height:76rpx}
