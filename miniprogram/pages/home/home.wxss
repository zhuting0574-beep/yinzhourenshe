.home-page {
  position: relative;
  background: #e9f8ff;
}
.home-capsule {
  position: absolute;
  z-index: 3;
  right: 26rpx;
  top: calc(26rpx + env(safe-area-inset-top));
  height: 56rpx;
  padding: 0 17rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}
.home-capsule .i {
  width: 1rpx;
  height: 28rpx;
  background: #888;
}
.hero {
  width: 100%;
  height: 420rpx;
  margin-top: -1rpx;
}
.hero-image {
  display: block;
  width: 100%;
  height: 100%;
}
.home-body {
  padding: 24rpx 28rpx 34rpx;
}
.hello {
  font-size: 30rpx;
  font-weight: 600;
  margin: 0 0 20rpx 4rpx;
}
.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22rpx;
}
.quick-card {
  height: 230rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 0 34rpx 8rpx rgba(109, 190, 229, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  font-size: 29rpx;
  font-weight: 600;
}
.quick-card image {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
}
.about-wrap {
  position: relative;
  margin-top: 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
}
.about {
  display: block;
  width: 100%;
}
.more {
  position: absolute;
  right: 22rpx;
  top: 23rpx;
  color: #737d85;
  font-size: 22rpx;
}
.about-mask {
  position: fixed;
  z-index: 110;
  inset: 0;
  background: rgba(16, 39, 65, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx 42rpx;
}
.about-modal {
  width: 100%;
  max-height: 82vh;
  border-radius: 28rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 20rpx 50rpx rgba(24, 54, 83, 0.34);
}
.about-modal__header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  padding: 0 84rpx;
  color: #153a61;
  font-size: 34rpx;
  font-weight: 700;
  border-bottom: 1rpx solid #edf2f6;
}
.about-modal__close {
  position: absolute;
  right: 18rpx;
  top: 22rpx;
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 50%;
  background: #f1f5f8;
  color: #637587;
  font-size: 38rpx;
  line-height: 52rpx;
}
.about-modal__body {
  box-sizing: border-box;
  max-height: calc(82vh - 100rpx);
  padding: 30rpx 32rpx 40rpx;
  color: #4b5d6c;
  font-size: 28rpx;
  line-height: 1.8;
}
.about-modal__image {
  display: block;
  width: 100%;
  margin: 0 0 24rpx;
}
.survey-mask {
  position: fixed;
  z-index: 120;
  inset: 0;
  background: rgba(16, 39, 65, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 76rpx 52rpx;
}
.survey-modal {
  position: relative;
  width: 100%;
  height: 620rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(#fff 0 63%, #ef6da5 63%);
  text-align: center;
  box-shadow: 0 20rpx 50rpx rgba(24, 54, 83, 0.34);
}
.modal-close {
  position: absolute;
  z-index: 2;
  right: 16rpx;
  top: 16rpx;
  width: 48rpx;
  height: 48rpx;
  padding: 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
  color: #fff;
  font-size: 36rpx;
  line-height: 43rpx;
}
.modal-brand {
  margin-top: 36rpx;
  font-size: 30rpx;
  color: #e7629d;
  font-weight: 900;
}
.modal-icon {
  width: 68rpx;
  height: 68rpx;
  margin: 24rpx auto 12rpx;
  border-radius: 12rpx;
  background: #f7c0d9;
  color: #df4f91;
  font-size: 42rpx;
  line-height: 68rpx;
}
.modal-config-image {
  display: block;
  width: 300rpx;
  height: 230rpx;
  margin: 4rpx auto 14rpx;
}
.modal-title {
  color: #e85b98;
  font-size: 35rpx;
  font-weight: 700;
  line-height: 1.35;
}
.modal-title text {
  display: block;
  font-size: 29rpx;
}
.modal-pi {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 52rpx;
  color: #1476d0;
  font: 900 220rpx/1 Arial;
  text-shadow: 7rpx 7rpx #fff;
}
.survey-go {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 14rpx;
  background: transparent;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}
.survey-go text {
  font-size: 20rpx;
  margin-left: 8rpx;
}
