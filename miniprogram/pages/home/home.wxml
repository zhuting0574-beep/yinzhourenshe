<view class="page"><swiper class="banner" autoplay circular indicator-dots><swiper-item wx:for="{{banners}}" wx:key="id"><image src="{{item.image_url}}" mode="aspectFill"/><text>{{item.title}}</text></swiper-item><swiper-item wx:if="{{!banners.length}}"><view class="banner-fallback">鄞领π<small>连接青年 活动与城市生活</small></view></swiper-item></swiper><view class="hello">{{points?'Hi，可用积分 '+points:'欢迎来到鄞领π'}}</view><view class="quick"><navigator url="/pages/activities/activities">活动报名</navigator><navigator url="/pages/products/products">积分兑换</navigator><navigator url="/pages/checkin/checkin">每日签到</navigator></view><view class="section">推荐活动</view><view wx:for="{{activities}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openActivity"><image src="{{item.cover_url}}" mode="aspectFill"/><view><text>{{item.title}}</text><small>{{item.start_time}} - {{item.end_time}}</small></view></view><button class="scan" bindtap="scan">⌗</button></view>
