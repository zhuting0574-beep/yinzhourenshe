[Unit]
Description=Yinzhou Community Spring Boot API (test)
After=network.target mysqld.service redis.service

[Service]
Type=simple
WorkingDirectory=/opt/yinzhou-test
EnvironmentFile=/opt/yinzhou-test/app.env
Environment="JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:+UseSerialGC"
Environment=SERVER_PORT=8082
Environment=SERVER_ADDRESS=127.0.0.1
ExecStart=/usr/bin/java -jar /opt/yinzhou-test/community-service.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
